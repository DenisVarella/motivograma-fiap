rules_version = '2';

// Cole estas regras no Firestore do projeto.
// O app grava pelo navegador, sem login: o documento usa o RM como id.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{rm} {
      allow read: if rmValido(rm);
      allow create, update: if rmValido(rm)
        && request.resource.data.rm == rm
        && nomeValido(request.resource.data.nome);
      allow delete: if false;
    }

    match /respostas/{rm} {
      allow read: if rmValido(rm);
      allow create, update: if rmValido(rm)
        && request.resource.data.rm == rm
        && request.resource.data.respostas is list
        && request.resource.data.respostas.size() == 30;
      allow delete: if false;
    }
  }
}

function rmValido(rm) {
  return rm.matches('^[0-9]{4,12}$');
}

function nomeValido(nome) {
  return nome is string && nome.size() > 0 && nome.size() <= 120;
}
